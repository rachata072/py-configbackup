# Copy this file to .env and fill in real values. .env is gitignored
# on purpose, never commit real credentials or app passwords.

# --- Per-device SSH passwords ---
# These names must match the "password_env" column in your inventory
# CSV exactly, one variable per device.
CONFIGBACKUP_LAB_R1_PASSWORD=changeme
CONFIGBACKUP_LAB_R2_PASSWORD=changeme

# --- Email alert settings (Gmail App Password) ---
# See RUNBOOK.md, "Set up the Gmail App Password", for how to
# generate CONFIGBACKUP_SMTP_APP_PASSWORD.
CONFIGBACKUP_SMTP_HOST=smtp.gmail.com
CONFIGBACKUP_SMTP_PORT=587
CONFIGBACKUP_SMTP_USERNAME=youraddress@gmail.com
CONFIGBACKUP_SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
CONFIGBACKUP_ALERT_FROM=youraddress@gmail.com
CONFIGBACKUP_ALERT_TO=youraddress@gmail.com
